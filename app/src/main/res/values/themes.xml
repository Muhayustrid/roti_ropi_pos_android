<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Warm Commerce styling for the legacy XML surfaces (profile selection and the
        task status bar). Compose feature screens use the Compose PosTheme/Warm
        Commerce tokens instead. Behavior is unchanged; only colors are restyled.
    -->
    <style name="Theme.POSERPNext" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/warm_amber</item>
        <item name="colorOnPrimary">@color/warm_on_amber</item>
        <item name="colorPrimaryContainer">@color/warm_amber</item>
        <item name="colorOnPrimaryContainer">@color/warm_on_amber_container</item>
        <item name="colorSecondary">@color/warm_teal</item>
        <item name="colorOnSecondary">@color/warm_on_teal</item>
        <item name="colorSecondaryContainer">@color/warm_teal_container</item>
        <item name="colorOnSecondaryContainer">@color/warm_on_teal_container</item>
        <item name="android:colorBackground">@color/warm_cream</item>
        <item name="colorSurface">@color/warm_cream</item>
        <item name="colorOnSurface">@color/warm_ink</item>
        <item name="colorSurfaceVariant">@color/warm_cream_variant</item>
        <item name="colorOnSurfaceVariant">@color/warm_ink_variant</item>
        <item name="colorOutline">@color/warm_outline</item>
        <item name="colorError">@color/warm_error</item>
        <item name="colorOnError">@color/warm_on_error</item>
    </style>
</resources>
