# Local edge in front of the bench, for Android App Links verification.
#
# Two jobs:
#   1. Serve /.well-known/assetlinks.json as application/json. Frappe cannot do
#      this: frappe/website/page_renderers/static_page.py lists "json" in
#      UNSUPPORTED_STATIC_PAGE_TYPES, and app.py maps SharedDataMiddleware only
#      to /assets and /files.
#   2. Proxy application traffic to Frappe with its site Host while preserving
#      HTTPS as the external scheme. Frappe's host_name remains the stable public
#      origin, so generated absolute URLs stay on oauth-staging.rotiropi.web.id.
#
# TLS is terminated at the Cloudflare edge, so this listener is plain HTTP on
# loopback only. Nothing outside this machine can reach it directly.
#
# Usage:
#   APPLINKS_DIR="$PWD/tools/applinks" caddy run --config tools/applinks/Caddyfile
#   cloudflared tunnel run rotiropi-pos-staging
{
	auto_https off
	admin off
}

:8080 {
	@assetlinks path /.well-known/assetlinks.json
	handle @assetlinks {
		root * {$APPLINKS_DIR}
		rewrite * /assetlinks.json
		header Content-Type application/json
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host development.localhost
			header_up X-Forwarded-Host oauth-staging.rotiropi.web.id
			header_up X-Forwarded-Proto https
		}
	}
}
